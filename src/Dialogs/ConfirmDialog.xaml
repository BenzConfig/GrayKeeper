<Window
    x:Class="GrayKeeper.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ResizeMode="NoResize" WindowStyle="None"
    WindowStartupLocation="CenterOwner"
    Background="Transparent"
    Width="360" Height="180">

    <Border Background="{StaticResource WindowBrush}">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                FontFamily="Segoe UI"
                FontWeight="Medium"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="Удаление"/>

            <!-- Текст -->
            <TextBlock Grid.Row="1"
                FontFamily="Segoe UI"
                FontWeight="Regular"
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Удалить выбранную командировку?"
                TextWrapping="Wrap"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Button
                    FontFamily="Segoe UI"
                    FontWeight="Regular"
                    FontSize="12"
                    Width="100"
                    Height="30"
                    Margin="0,0,5,0"
                    Content="Удалить"
                    Click="Delete_Click"
                    Style="{StaticResource DeleteConfirmButtonStyle}"/>

                <Button
                    FontFamily="Segoe UI"
                    FontWeight="Regular"
                    FontSize="12"
                    Width="100"
                    Height="30"
                    Margin="5,0,0,0"
                    Content="Отмена"
                    IsCancel="True"
                    Style="{StaticResource PrimaryButton}"/>
                
            </StackPanel>

        </Grid>

    </Border>

</Window>