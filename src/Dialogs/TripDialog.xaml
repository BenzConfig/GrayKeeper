<Window
    x:Class="GrayKeeper.Dialogs.TripDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    ShowInTaskbar="False"
    Width="460"
    Height="480"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBrush}"
    WindowStyle="None">

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome

            CaptionHeight="42"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False"/>

    </shell:WindowChrome.WindowChrome>

    <Grid>
        
        <Grid.RowDefinitions>

            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Background="#000000"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>

                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="5,0">

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable"
                        FontSize="14"
                        FontWeight="Light"
                        Foreground="White"
                        Text="Добавить новую запись"/>

                </StackPanel>

                <!-- Закрыть -->
                <Button
                    Grid.Column="1"
                    Width="46"
                    Height="42"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click">

                    <Image
                        Width="12"
                        Height="12"
                        Source="/Assets/window/close.png"/>

                </Button>

            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border
            Grid.Row="1"
            Margin="16"
            Style="{StaticResource CardStyle}">

            <Grid
                Margin="16">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- Организация -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0">

                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Margin="0,0,0,10"
                        Text="Организация"/>

                    <TextBox
                        x:Name="OrganizationBox"
                        Style="{StaticResource InputTextBox}"/>

                </StackPanel>

                <!-- Город -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,10,0,0">

                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Margin="0,0,0,10"
                        Text="Город"/>

                    <TextBox
                        x:Name="CityBox"
                        Style="{StaticResource InputTextBox}"/>

                </StackPanel>

                <!-- Начало -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,10,0,0">

                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="Дата начала"
                        Margin="0,0,0,10"/>

                    <DatePicker
                        x:Name="StartDatePicker"
                        Style="{StaticResource DarkDatePicker}"/>

                </StackPanel>

                <!-- Окончание -->
                <StackPanel
                    Grid.Row="4"
                    Margin="0,10,0,0">

                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="Дата окончания"
                        Margin="0,0,0,10"/>

                    <DatePicker
                        x:Name="EndDatePicker"
                        Style="{StaticResource DarkDatePicker}"/>

                </StackPanel>

                <!-- Кнопка -->
                <StackPanel
                    Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0">

                    <Button
                        Width="130"
                        Height="35"
                        Margin="0,10,0,15"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsDefault="True"
                        Click="Create_Click">
                    
                    <Image
                        Width="18"
                        Height="18"
                        Source="/Assets/main/check.png"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        
                    </Button>
                    
                </StackPanel>
                
            </Grid>
        </Border>

    </Grid>

</Window>