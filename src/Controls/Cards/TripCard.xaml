<UserControl x:Class="GrayKeeper.Controls.Cards.TripCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="CardRoot"
        Style="{StaticResource TripCardStyle}"
        RenderTransformOrigin="0.5,0.5"
        MouseEnter="CardRoot_MouseEnter"
        MouseLeave="CardRoot_MouseLeave">

        <Grid>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Контент -->
            <StackPanel Grid.Column="0"
                        Margin="15,5">

                <!-- Организация -->
                <TextBlock
                    FontFamily="Segoe UI"
                    FontWeight="Regular"
                    FontSize="14"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding Organization}"/>

                <!-- Город -->
                <TextBlock
                    FontFamily="Segoe UI"
                    FontWeight="Regular"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding City}"/>

                <!-- Даты -->
                <TextBlock
                    FontFamily="Segoe UI"
                    FontWeight="Regular"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Opacity="0.5"
                    Text="{Binding DateRange}">

                </TextBlock>

            </StackPanel>

            <!-- Кнопка редактирования -->
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding
                        DataContext.EditTripCommand,
                        RelativeSource={RelativeSource
                        AncestorType=ListBox}}"
                CommandParameter="{Binding}">

                <Button.Style>
                    
                    <Style
                        TargetType="Button"
                        BasedOn="{StaticResource EditStyle}">

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding
                                        RelativeSource={RelativeSource
                                        AncestorType=ListBoxItem},
                                        Path=IsSelected}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>

                <Image Width="15"
                       Height="15"
                       Source="/Assets/btn/refresh.png"/>
            </Button>

            <!-- Кнопка удаления -->
            <Button Grid.Column="2"
                Width="27"
                Height="27"
                Margin="0,0,10,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding
                        DataContext.DeleteTripCommand,
                        RelativeSource={RelativeSource
                        AncestorType=ListBox}}"
                CommandParameter="{Binding}"
                Style="{StaticResource DeleteButtonStyle}">

                <Image
                    Width="15"
                    Height="15"
                    Margin="0,0,1,0"
                    Source="/Assets/btn/delete.png"/>
            </Button>

        </Grid>
    </Border>
</UserControl>