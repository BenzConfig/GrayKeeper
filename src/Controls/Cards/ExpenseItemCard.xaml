<UserControl
    x:Class="GrayKeeper.Controls.Cards.ExpenseItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        x:Name="CardBorder"
        MinWidth="200"
        Height="100"
        Background="#202020"
        BorderBrush="#333333"
        BorderThickness="1"
        CornerRadius="10"
        SnapsToDevicePixels="True">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Дата -->
            <TextBlock
                Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                FontSize="12"
                FontWeight="SemiBold"
                Cursor="Hand"
                Foreground="{StaticResource PrimaryTextBrush}"/>

            <!-- Расходы -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Hidden">

                <StackPanel>

                    <TextBlock
                        Text="{Binding Rent, StringFormat=Аренда: {0} ₽}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="{Binding Rent,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                    <TextBlock
                        Text="{Binding PerDiem, StringFormat=Суточные: {0} ₽}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="{Binding PerDiem,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                    <TextBlock
                        Text="{Binding Fuel, StringFormat=Топливо: {0} ₽}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="{Binding Fuel,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                    <TextBlock
                        Text="{Binding Tickets, StringFormat=Билеты: {0} ₽}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="{Binding Tickets,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                    <TextBlock
                        Text="{Binding Other, StringFormat=Прочее: {0} ₽}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="{Binding Other,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                    <TextBlock
                        Text="{Binding Income, StringFormat=Поступление: {0} ₽}"
                        Foreground="{StaticResource AccentGreenBrush}"
                        Visibility="{Binding Income,
                            Converter={StaticResource DecimalToVisibilityConverter}}"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>