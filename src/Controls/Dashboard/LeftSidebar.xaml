<UserControl 
    x:Class="GrayKeeper.Controls.Dashboard.LeftSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border Margin="18" Style="{StaticResource CardStyle}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <Grid Grid.Row="0" Margin="15">

                <TextBox
                    Style="{StaticResource SearchTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Image
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Source="/Assets/main/search.png"
                    IsHitTestVisible="False"/>

            </Grid>

            <!-- Список -->
            <ListBox Grid.Row="1"
                Margin="10"
                BorderThickness="0"
                Background="Transparent"
                ItemsSource="{Binding TripsView}"
                SelectedItem="{Binding SelectedTrip}"
                ItemTemplate="{StaticResource TripTemplate}"/>

            <!-- Нижние кнопки -->
            <Grid
                Grid.Row="2"
                Margin="10,0,10,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>


                <!-- Добавить командировку -->
                <Button
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddTripCommand}"
                    ToolTip="Добавить командировку">

                    <Image
                        Width="18"
                        Height="18"
                        Source="/Assets/btn/add.png"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Button>


                <!-- О программе -->
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Margin="10,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="AboutButton_Click"
                    ToolTip="О программе">

                    <Image
                        Width="18"
                        Height="18"
                        Source="/Assets/btn/about.png"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Button>


                <!-- Свободное пространство -->
                <Grid Grid.Column="2"/>


                <!-- Экспорт -->
                <Button
                    Grid.Column="3"
                    Width="40"
                    Height="40"
                    Style="{StaticResource PrimaryButton}"
                    Click="ExportButton_Click"
                    ToolTip="Экспорт в Excel">

                    <Image
                        Width="18"
                        Height="18"
                        Source="/Assets/btn/save_alt.png"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Button>

            </Grid>

        </Grid>

	</Border>

</UserControl>