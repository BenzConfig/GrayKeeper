<UserControl
    x:Class="GrayKeeper.Controls.Dashboard.BalancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Style="{StaticResource CardStyle}">

        <Grid
            Margin="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Поступило -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Margin="20,0,0,0"
                    Text="Поступило"
                    FontSize="14"/>

                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding TotalIncome, StringFormat={}{0:N0} ₽}"/>
                
            </StackPanel>

            <!-- Потрачено -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="Потрачено"
                    FontSize="14"/>

                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding TotalExpenses, StringFormat={}{0:N0} ₽}"/>

            </StackPanel>

            <!-- Баланс -->
            <StackPanel 
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="Баланс"
                    FontSize="14"/>

                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AccentGreenBrush}"
                    Text="{Binding Balance, StringFormat={}{0:N0} ₽}"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>