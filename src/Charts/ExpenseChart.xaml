<UserControl
    x:Class="GrayKeeper.Charts.ExpenseChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Border Background="#111111" CornerRadius="10" Padding="10">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LABELS -->
            <Grid Grid.Column="0" Margin="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                    Text="{Binding ExpenseLabels[0]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1"
                    Text="{Binding ExpenseLabels[1]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2"
                    Text="{Binding ExpenseLabels[2]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3"
                    Text="{Binding ExpenseLabels[3]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="4"
                    Text="{Binding ExpenseLabels[4]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="5"
                    Text="{Binding ExpenseLabels[5]}"
                    Foreground="#919191"
                    FontSize="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

            </Grid>

            <!-- CHART -->
            <lvc:CartesianChart Grid.Column="1"
                Series="{Binding ExpenseSeries}"
                XAxes="{Binding ExpenseXAxes}"
                YAxes="{Binding ExpenseYAxes}"
                LegendPosition="Hidden"
                TooltipPosition="Hidden"
                ZoomMode="None"
                Background="Transparent"/>

        </Grid>

    </Border>

</UserControl>