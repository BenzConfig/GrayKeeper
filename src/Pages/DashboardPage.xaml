<UserControl
    x:Class="GrayKeeper.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="clr-namespace:GrayKeeper.Controls.Dashboard"
    xmlns:charts="clr-namespace:GrayKeeper.Charts"
    DataContext="{Binding}">

    <Grid Background="{StaticResource WindowBrush}"
          PreviewMouseDown="DashboardPage_PreviewMouseDown">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>   

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <dashboard:LeftSidebar Grid.Column="0"/>

        <!-- ПРАВАЯ ЧАСТЬ -->
        <Grid Grid.Column="1" Margin="0,18,18,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <!-- Баланс -->
            <dashboard:BalancePanel DataContext="{Binding}"/>

            <!-- Центральная область -->
            <Border Grid.Row="1" Margin="0,10"
                    Style="{StaticResource CardStyle}">

                <dashboard:ExpensesPanel Grid.Row="1"  Margin="0,10" DataContext="{Binding}"/>
                
            </Border>

            <!-- Нижняя часть -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Поля ввода -->
                <Border Grid.Column="0" Margin="0,0,8,0"
                        Style="{StaticResource CardStyle}">

                    <Grid Margin="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Поля ввода -->
                        <ScrollViewer
                            Grid.Row="0"
                            Height="180"
                            VerticalAlignment="Top"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Disabled"
                            CanContentScroll="True">

                            <StackPanel>
                                
                                <TextBox
                                    x:Name="DateBox"
                                    Style="{StaticResource InputTextBox}"
                                    Tag="Дата"
                                    Margin="5,5,5,10"
                                    Text="{Binding SelectedExpense.Date, StringFormat=dd.MM.yy, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBox
                                    x:Name="RentBox"
                                    Style="{StaticResource InputTextBox}"
                                    Tag="Гостиница"
                                    Margin="5,0,5,10"
                                    Text="{Binding SelectedExpense.Rent, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   Converter={StaticResource ZeroToEmptyConverter}}"/>

                                <TextBox
                                     x:Name="PerDiemBox"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="Суточные"
                                     Margin="5,0,5,10"
                                     Text="{Binding SelectedExpense.PerDiem, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    Converter={StaticResource ZeroToEmptyConverter}}"/>


                                <TextBox
                                    x:Name="FuelBox"
                                    Style="{StaticResource InputTextBox}"
                                    Tag="Топливо"
                                    Margin="5,0,5,10"
                                    Text="{Binding SelectedExpense.Fuel, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   Converter={StaticResource ZeroToEmptyConverter}}"/>

                                <TextBox
                                    x:Name="TicketBox"
                                    Style="{StaticResource InputTextBox}"
                                    Tag="Билеты"
                                    Margin="5,0,5,10"
                                    Text="{Binding SelectedExpense.Tickets, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   Converter={StaticResource ZeroToEmptyConverter}}"/>

                                 <TextBox
                                     x:Name="OtherBox"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="Прочее"
                                     Margin="5,0,5,10"
                                     Text="{Binding SelectedExpense.Other, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    Converter={StaticResource ZeroToEmptyConverter}}"/>

                                <TextBox
                                    x:Name="IncomeBox"
                                    Style="{StaticResource InputTextBox}"
                                    Tag="Поступление"
                                    Margin="5,0,5,10"
                                    Text="{Binding SelectedExpense.Income, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    Converter={StaticResource ZeroToEmptyConverter}}"/>

                            </StackPanel>
                            
                        </ScrollViewer>

                        <!-- Кнопки -->
                        <Grid Grid.Row="1"
                              Margin="10,0,0,5"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom">

                            <!-- ДОБАВИТЬ -->
                            <Button x:Name="AddExpenseButton"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryButton}"
                                Click="AddExpense_Click"
                                RenderTransformOrigin="0.5,0.5">

                                <Button.RenderTransform>
                                    <ScaleTransform
                                        x:Name="AddButtonScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                                </Button.RenderTransform>

                                <Image
                                    Width="18"
                                    Height="18"
                                    Source="{Binding AddButtonIcon}"/>

                            </Button>

                            <!-- РЕДАКТИРОВАТЬ -->
                            <Button x:Name="EditExpenseButton"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryButton}"
                                Click="EditExpense_Click"
                                Opacity="0"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">

                                <Button.RenderTransform>
                                    <ScaleTransform
                                        x:Name="EditButtonScale"
                                        ScaleX="0.6"
                                        ScaleY="0.6"/>
                                </Button.RenderTransform>

                                <Image
                                    Width="18"
                                    Height="18"
                                    Source="/Assets/btn/refresh.png"/>

                            </Button>

                            <!-- УДАЛИТЬ -->
                            <Button x:Name="DeleteExpenseButton"
                                Width="40"
                                Height="40"
                                Margin="50,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource DeleteButtonStyle}"
                                Command="{Binding DeleteExpenseCommand}"
                                Opacity="0"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">

                                <Button.RenderTransform>
                                    <TransformGroup>

                                        <ScaleTransform
                                            x:Name="DeleteButtonScale"
                                            ScaleX="0.6"
                                            ScaleY="0.6"/>

                                        <TranslateTransform
                                            x:Name="DeleteButtonTranslate"
                                            X="-50"/>

                                    </TransformGroup>
                                </Button.RenderTransform>

                                <Image
                                    Width="18"
                                    Height="18"
                                    Source="/Assets/btn/delete.png"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Button>

                        </Grid>

                    </Grid>
                    
                </Border>

                <!-- Расходы -->
                <Border Grid.Column="1" Margin="4,0"
                        Style="{StaticResource CardStyle}">
                    
                    <charts:ExpenseChart DataContext="{Binding}"/>

                </Border>

                <!-- График -->
                <Border Grid.Column="2" Margin="8,0,0,0"
                        Style="{StaticResource CardStyle}">

                    <dashboard:BalanceChart/>
                    
                </Border>
                
            </Grid>

        </Grid>

    </Grid>

</UserControl>