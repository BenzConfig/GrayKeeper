<Window
    x:Class="GrayKeeper.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="О программе"
    Width="500" Height="290"
    WindowStyle="None"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="#0A0A0A">

    <Border>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                Background="Black"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <!-- Заголовок -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="О программе"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="14"
                        FontWeight="Light"
                        Foreground="White"/>

                </StackPanel>

            </Border>

            
            <!-- ОСНОВНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0" Grid.Row="1"
                       Width="130" Height="Auto" Margin="50,0,20,0"
                       Source="/Assets/brand/logo.png"/>

                <!-- Text -->
                <Border Grid.Column="1"
                    Grid.Row="1"
                    Height="150"
                    Padding="10"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Margin="10">

                    <StackPanel VerticalAlignment="Center">

                        <!-- Название -->
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="20"
                            Foreground="White"
                            Margin="0,0,0,15"
                            Text="GrayKeeper"/>

                        <!-- Лицензия -->
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Foreground="#919191">

                            <Run Text="Лицензия "/>

                            <Hyperlink
                                NavigateUri="https://www.gnu.org"
                                RequestNavigate="Hyperlink_RequestNavigate"
                                Foreground="#B0B0B0">

                                <Run Text="GNU GPL V3"/>

                            </Hyperlink>

                        </TextBlock>

                        <!-- Материал -->
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Foreground="#919191">

                            <Run Text="Материал "/>

                            <Hyperlink
                                NavigateUri="https://www.soloist.ai/nrg"
                                RequestNavigate="Hyperlink_RequestNavigate"
                                Foreground="#B0B0B0">

                                <Run Text="www.soloist.ai/nrg"/>

                            </Hyperlink>

                        </TextBlock>

                        <!-- Исходный код -->
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Foreground="#919191">

                            <Run Text="Исходник "/>

                            <Hyperlink
                                NavigateUri="https://www.github.com/benzenergy"
                                RequestNavigate="Hyperlink_RequestNavigate"
                                Foreground="#B0B0B0">

                                <Run Text="www.github.com"/>

                            </Hyperlink>

                        </TextBlock>
                        
                        <!-- Копирайт -->
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontWeight="Regular"
                            FontSize="14"
                            Foreground="#919191"
                            Margin="0,15,0,0"
                            Opacity="0.7"
                            Text="© 2026 NRG'S. All right reserved."/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- FOOTER -->
            <Border
                Grid.Row="2"
                Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Закрыть -->
                <Button
                    Grid.Column="1"
                    Width="100"
                    Height="32"
                    Background="#151515"
                    Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButton}">

                    <Image
                        Width="18"
                        Height="18"
                        Source="/Assets/main/check.png"/>

                </Button>
                
            </Border>

        </Grid>

    </Border>

</Window>