<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета -->
    <Color x:Key="WindowColor">#0A0A0A</Color>
    <Color x:Key="SidebarColor">#111111</Color>
    <Color x:Key="CardColor">#111111</Color>

    <!-- Состояния -->
    <Color x:Key="HoverColor">#181818</Color>
    <Color x:Key="SelectedColor">#202020</Color>
    <Color x:Key="BorderColor">#262626</Color>

    <!-- Акценты -->
    <Color x:Key="AccentColor">#45C7FF</Color>
    <Color x:Key="AccentGreen">#38D67A</Color>
    <Color x:Key="AccentRed">#FF5A5A</Color>
    <Color x:Key="AccentOrange">#FFB347</Color>

    <!-- Текст -->
    <Color x:Key="TextColor">#F2F2F2</Color>
    <Color x:Key="SecondaryTextColor">#8A8A8A</Color>
    <Color x:Key="TripCardBorderColor">#333333</Color>
    <Color x:Key="TripCardHoverColor">#252A2F</Color>
    <Color x:Key="TripCardSelectedBorderColor">#39FF88</Color>

    <!-- Календарь -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#181818"/>
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#181818"/>
    <SolidColorBrush x:Key="MaterialDesignSurface" Color="#181818"/>
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="#181818"/>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>

    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="CardSelectedBrush" Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrushDark" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AccentOrange}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <!-- Trip cards -->
    <Color x:Key="DeleteHoverColor">#FF4545</Color>
    <Color x:Key="DeletePressedColor">#CC3030</Color>
    <Color x:Key="TripCardColor">#151515</Color>
    
    <!-- TripCard borders -->
    <Color x:Key="TripBorderNormal">#282828</Color>
    <Color x:Key="TripBorderHover">#454545</Color>
    <Color x:Key="TripBorderSelected">#656565</Color>

    <SolidColorBrush x:Key="TripBorderNormalBrush" Color="{StaticResource TripBorderNormal}"/>
    <SolidColorBrush x:Key="TripBorderHoverBrush" Color="{StaticResource TripBorderHover}"/>
    <SolidColorBrush x:Key="TripBorderSelectedBrush" Color="{StaticResource TripBorderSelected}"/>
    
    <SolidColorBrush x:Key="TripCardSelectedBorderBrush" Color="{StaticResource TripCardSelectedBorderColor}"/>
    <SolidColorBrush x:Key="TripCardBrush" Color="{StaticResource TripCardColor}"/>
    <SolidColorBrush x:Key="TripCardBorderBrush" Color="{StaticResource TripCardBorderColor}"/>
    <SolidColorBrush x:Key="TripCardHoverBrush" Color="{StaticResource TripCardHoverColor}"/>
    <SolidColorBrush x:Key="DeleteHoverBrush" Color="{StaticResource DeleteHoverColor}"/>
    <SolidColorBrush x:Key="DeletePressedBrush" Color="{StaticResource DeletePressedColor}"/>
    
</ResourceDictionary>